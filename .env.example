# Public browser-safe Supabase project values. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical application origin used for authentication email redirects.
# Use http://localhost:3000 for local development and HTTPS in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
